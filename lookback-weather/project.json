{
	"file": "index.html",
	"type": "web",
	"title": "蓦然回首 · 实时天气与真实日照",
	"description": "实时当地天气与真实太阳位置驱动的《蓦然回首》结尾场景。支持自动定位城市、窗户朝向、锁定时刻。天气数据来自 open-meteo.com（免费、无需密钥）。\n\n本地测试素材来自工坊 3365960230，作者 被_整除，仅供本地调试；公开发布前请替换为你自己的美术。",
	"contentrating": "Everyone",
	"tags": [
		"Anime"
	],
	"visibility": "private",
	"preview": "preview.png",
	"general": {
		"supportsaudioprocessing": true,
		"properties": {
			"hudTip": {
				"order": 1,
				"text": "说明：太阳位置按你所在城市经纬度实时计算，断网也能用；天气需要联网获取。"
			},
			"locateMode": {
				"order": 10,
				"type": "combo",
				"text": "定位方式",
				"options": [
					{
						"label": "自动（IP 定位）",
						"value": "auto"
					},
					{
						"label": "手动输入城市名",
						"value": "manual"
					},
					{
						"label": "手动输入经纬度",
						"value": "latlon"
					}
				],
				"value": "auto"
			},
			"cityInput": {
				"order": 11,
				"type": "textinput",
				"condition": "locateMode.value == 'manual'",
				"text": "城市名",
				"value": "北京"
			},
			"latLonInput": {
				"order": 12,
				"type": "textinput",
				"condition": "locateMode.value == 'latlon'",
				"text": "纬度,经度",
				"value": "39.9042,116.4074"
			},
			"solarMode": {
				"order": 20,
				"type": "combo",
				"text": "太阳位置来源",
				"options": [
					{
						"label": "真实太阳（按城市）",
						"value": "real"
					},
					{
						"label": "跟随系统时钟",
						"value": "clock"
					},
					{
						"label": "手动锁定时刻",
						"value": "manual"
					}
				],
				"value": "real"
			},
			"manualHour": {
				"order": 21,
				"type": "slider",
				"condition": "solarMode.value == 'manual'",
				"text": "锁定时刻（小时）",
