				"max": 23,
				"step": 1,
				"precision": 0,
				"value": 18
			},
			"windowDir": {
				"order": 30,
				"type": "combo",
				"text": "窗户朝向",
				"options": [
					{
						"label": "正北",
						"value": 0
					},
					{
						"label": "东北",
						"value": 45
					},
					{
						"label": "正东",
						"value": 90
					},
					{
						"label": "东南",
						"value": 135
					},
					{
						"label": "正南",
						"value": 180
